# Copy to .env at the repository root (the real .env is git-ignored).
# Read by the three Vite apps (rehearsal, evaluator, overlay) through vite.config.js envDir.

# Where the backend runs. Default if unset: http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# Rehearsal app only: how long to wait for one /analyze answer, in milliseconds. Default if unset: 300000 (5 minutes).
# The first request after the server starts can be slow because the models load.
# VITE_REQUEST_TIMEOUT_MS=300000
